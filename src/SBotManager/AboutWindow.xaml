<Window x:Class="SBotManager.AboutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="About i1988 - sBot manager" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="#101722" Foreground="#EEF2FA" FontFamily="Segoe UI" FontSize="13" Icon="pack://application:,,,/Assets/app.ico">
 <StackPanel Margin="24,22,24,20">
  <TextBlock Text="i1988 - sBot manager" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Text="Version 0.0.2" Foreground="#98A4B8" Margin="0,4,0,0"/>
  <TextBlock Text="A local Windows workspace for managing verified sBot accounts." TextWrapping="Wrap" Foreground="#BDCADB" Margin="0,18,0,0" LineHeight="19"/>
  <TextBlock Text="SUPPORT THE PROJECT" Style="{StaticResource SectionLabel}" Margin="0,22,0,0"/>
  <Border Style="{StaticResource Panel}" Padding="16" Margin="0,8,0,0">
   <StackPanel>
    <TextBlock Text="If this manager saves you time, you can support its development." TextWrapping="Wrap" Foreground="#BDCADB"/>
    <WrapPanel Margin="0,12,0,0">
     <Button Content="Support on Ko-fi" Click="Kofi_Click" AutomationProperties.AutomationId="OpenKofi" Margin="0,0,8,0"/>
     <Button Content="InstaPay (EG)" Click="InstaPay_Click" AutomationProperties.AutomationId="OpenInstaPay"/>
    </WrapPanel>
    <Button Content="Contact support" Click="Contact_Click" Background="Transparent" Margin="0,10,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="ContactSupport"/>
   </StackPanel>
  </Border>
  <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" Margin="0,18,0,0" AutomationProperties.AutomationId="CloseAbout"/>
 </StackPanel>
</Window>
