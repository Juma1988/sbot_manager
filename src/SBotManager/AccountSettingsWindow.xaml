<Window x:Class="SBotManager.AccountSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Character settings" Width="620" Height="590" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#141C29" Foreground="#EEF2FA" FontFamily="Segoe UI" FontSize="13">
 <StackPanel Margin="26">
  <TextBlock x:Name="Heading" Text="Character settings" FontSize="23" FontWeight="SemiBold"/>
  <TextBlock Text="Character name" Margin="0,20,0,7"/>
  <TextBox x:Name="NameInput" MaxLength="24" AutomationProperties.AutomationId="CharacterName"/>
  <TextBlock Text="sBot executable" Margin="0,16,0,7"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="PathInput" IsReadOnly="True" VerticalContentAlignment="Center" AutomationProperties.AutomationId="ExecutablePath"/><Button Grid.Column="1" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0" AutomationProperties.AutomationId="BrowseExecutable"/></Grid>
  <Grid Margin="0,7,0,10"><TextBlock x:Name="Validation" Foreground="#F4CB7B" VerticalAlignment="Center"/><Button Content="Copy path" Click="Copy_Click" HorizontalAlignment="Right" Padding="10,5" MinHeight="30"/></Grid>
  <CheckBox x:Name="RecoveryInput" Content="Recover this bot if its process disappears" Margin="0,8,0,8"/>
  <TextBlock Text="Recovery is opt-in: up to 3 retries, with increasing delays. Reopening sBot may activate its own automatic login/training settings. Stop training and Terminate pause manager recovery." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="19"/>
  <TextBlock x:Name="ErrorText" Foreground="#F1A6A6" TextWrapping="Wrap" MinHeight="45" Margin="0,12,0,0"/>
  <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="RemoveButton" Content="Remove entry…" Click="Remove_Click" HorizontalAlignment="Left" Foreground="#F1A6A6" AutomationProperties.AutomationId="RemoveAccount"/>
   <Button Grid.Column="1" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
   <Button Grid.Column="2" Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}" IsDefault="True" AutomationProperties.AutomationId="SaveAccount"/>
  </Grid>
 </StackPanel>
</Window>
